# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.benchmarks/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Vault runtime data — NEVER commit
.secure-vault/
*.db
*.db-wal
*.db-shm
keychain.json
sealed.bin
*.priv
*.pub
# ...except fixed TEST fixtures under go/**/testdata (throwaway keys, generated by
# the packages' gen scripts). Without this they silently drop out of commits.
!go/**/testdata/**/keychain.json
!go/**/testdata/**/*.db
!go/**/testdata/**/sealed.bin
!go/**/testdata/**/*.priv
!go/**/testdata/**/*.pub

# Go build artifacts
go/rgt-vault
go/gateway
go/server
*.test

# Editor / OS
.vscode/
.idea/
.DS_Store
test-env/

# Agent scratch notes (briefings, handoffs). Already-tracked files predate this rule.
.agents/
