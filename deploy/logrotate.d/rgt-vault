# /etc/logrotate.d/rgt-vault
#
# Reference log rotation policy for optional file-based rgt-vault logs
# (ASVS V7 / Refs RGT-430, RGT-512).
#
# IMPORTANT DEPLOYMENT NOTES:
#   1. Default mode: deploy/rgt-vault-go.service writes exclusively to
#      stdout/stderr under systemd-journald (configured via
#      deploy/journald.conf.d/rgt-vault.conf) with ProtectSystem=strict and
#      ReadWritePaths=/var/lib/rgt-vault. File logging in go/internal/logging is
#      NOT yet wired into rgt-vault serve (tracked in RGT-512), and the Go
#      daemon does not install a SIGHUP handler — never send SIGHUP from
#      postrotate, or Go's default signal disposition will terminate the service.
#   2. Optional file-logging mode (if redirecting output or after RGT-512):
#      Provision /var/log/rgt-vault owned by root:adm mode 0750 (for example via
#      systemd-tmpfiles: `d /var/log/rgt-vault 0750 root adm -`) so the
#      unprivileged rgtvault user cannot unlink rotated archives, and use
#      copytruncate below until SIGHUP FileWriter.Reopen() wiring (RGT-512) lands.

/var/log/rgt-vault/*.log {
    su root adm
    daily
    rotate 90
    maxage 90
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
    # Active log is owned by rgtvault and readable only by the adm audit group
    # (never world-readable).
    create 0640 rgtvault adm
    sharedscripts
    postrotate
        # Ensure rotated segments belong to root:adm mode 0440 (read-only).
        chown root:adm /var/log/rgt-vault/*.log.[0-9]* /var/log/rgt-vault/*.gz 2>/dev/null || true
        chmod 0440 /var/log/rgt-vault/*.log.[0-9]* /var/log/rgt-vault/*.gz 2>/dev/null || true
    endscript
}
