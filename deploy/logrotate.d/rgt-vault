# /etc/logrotate.d/rgt-vault
#
# Reference log rotation policy for optional file-based rgt-vault logs
# (ASVS V7 / Refs RGT-430, RGT-512).
#
# IMPORTANT DEPLOYMENT NOTES:
#   1. Default mode: file logging is NOT active. deploy/rgt-vault-go.service
#      writes only to stdout/stderr under systemd-journald (see
#      deploy/journald.conf.d/rgt-vault.conf) and has ProtectSystem=strict with
#      ReadWritePaths=/var/lib/rgt-vault, so it cannot write /var/log/rgt-vault.
#      go/internal/logging (including its FileWriter) is not yet wired into
#      `rgt-vault serve`; that wiring is follow-up work (RGT-512). Until then
#      this file is a reference policy that matches nothing on a default install.
#   2. Never send SIGHUP from postrotate. The daemon's only SIGHUP handler
#      reloads the TLS certificate (a no-op without --tls-cert); it does not
#      reopen log files, so a SIGHUP here would be misleading at best. Rotation
#      uses copytruncate (the writer opens with O_APPEND, so truncation is safe
#      and no reopen is needed) until SIGHUP -> FileWriter.Reopen() is wired.
#   3. If you do redirect output to a file, you must (a) add /var/log/rgt-vault
#      to ReadWritePaths in a drop-in and (b) provision the directory so the
#      unprivileged rgtvault user cannot delete rotated archives, for example
#      with systemd-tmpfiles: `d /var/log/rgt-vault 0750 rgtvault adm -`. The
#      directory stays writable by rgtvault (it must create the active file), so
#      rgtvault CAN remove archives there; the root:adm 0440 chown/chmod below
#      stops edits to an archive's content but NOT deletion. Tamper-evidence
#      against rgtvault needs root-owned archives in a root-owned directory
#      (ship logs off-host or keep the journal), which this file does not set up.

/var/log/rgt-vault/*.log {
    su root adm
    daily
    rotate 90
    maxage 90
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
    # Ignored by copytruncate (the active file keeps its inode and the 0600
    # mode FileWriter gives it); kept so a later switch to the create-and-HUP
    # method (RGT-512) gets a never-world-readable file.
    create 0640 rgtvault adm
    sharedscripts
    postrotate
        # Ensure rotated segments belong to root:adm mode 0440 (read-only).
        chown root:adm /var/log/rgt-vault/*.log.[0-9]* /var/log/rgt-vault/*.gz 2>/dev/null || true
        chmod 0440 /var/log/rgt-vault/*.log.[0-9]* /var/log/rgt-vault/*.gz 2>/dev/null || true
    endscript
}
