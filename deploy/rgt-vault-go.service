[Unit]
Description=rgt-vault Go server (persistent vault, bearer-token API)
Documentation=https://github.com/WilliamHudspeth/rgt-vault
After=network.target

[Service]
Type=simple

# --- the trust boundary ------------------------------------------------ #
# Same model as deploy/rgt-vault.service: the daemon runs as its own
# unprivileged account (created by deploy/setup-daemon.sh). Agents never
# share this user, so they cannot read the token file or process memory.
User=rgtvault
Group=rgtvault

# State lives in /var/lib/rgt-vault, mode 0700, created and owned by the
# service user via StateDirectory=: the vault (vault.db + keychain.json), the
# 0600 bearer-token files and, if used, the sealed master-secret blobs.
StateDirectory=rgt-vault
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rgt-vault
UMask=0077

# --- the vault (RGT-505) ------------------------------------------------ #
# `rgt-vault serve` opens a REAL, persistent vault; nothing is kept in memory.
#   --db        under the state dir (ProtectHome hides ~/.secure-vault)
#   --policy    ABAC policy YAML, read-only under /etc. Without it every
#               request is denied (default deny), so a missing file is an
#               error here on purpose: create /etc/rgt-vault/policy.yaml first.
#   --provider  platform. There is no session D-Bus for a Secret Service
#               keyring under systemd, so the default `keyring` provider cannot
#               work. On Linux `platform` is the TPM 2.0: provision it ONCE,
#               as the service user, before the first start:
#                 sudo -u rgtvault rgt-vault provider seal tpm --generate \
#                      --out-dir /var/lib/rgt-vault/sealed
#                 sudo -u rgtvault rgt-vault init --provider platform \
#                      --db /var/lib/rgt-vault/vault.db \
#                      --token-store /var/lib/rgt-vault/tokens.json \
#                      --operator-token-file /var/lib/rgt-vault/operator.token
#               then one token per agent (batch H1, per-agent identity):
#                 sudo -u rgtvault rgt-vault token mint --store \
#                      /var/lib/rgt-vault/tokens.json --agent NAME --out FILE
#               The sealed blobs are found through VAULT_TPM_PRIV/VAULT_TPM_PUB.
#               (Python's equivalent is `seal_master_secret`; Windows uses DPAPI,
#               macOS the Keychain: `rgt-vault provider seal --help`.)
#   --port      8765, Python's port (decision D6; the unit used 8080 before).
# The TPM device is the one hole in PrivateDevices=true below: it is bound in
# and allowed explicitly. NOT verified on real TPM hardware (no CI runner has
# one): check `systemctl status` / the journal on the first start.
Environment=VAULT_TPM_PRIV=/var/lib/rgt-vault/sealed/master_secret.priv
Environment=VAULT_TPM_PUB=/var/lib/rgt-vault/sealed/master_secret.pub
SupplementaryGroups=tss
BindPaths=-/dev/tpmrm0
DeviceAllow=/dev/tpmrm0 rw

# Production mode (RGT-427, ASVS 14.3): APP_ENV=production marks the unit as
# a production deployment. The unauthenticated /healthz answer is always just
# {"status":"ok"} (the build version is only shown to audit/operator tokens),
# so the variable no longer changes it. Error responses are
# generic in every mode (a short message plus an incident_id; panics and
# internal errors are logged server-side under that id, never sent to the
# client). scripts/lint_systemd_units.sh fails if a unit running
# `rgt-vault serve` stops setting it.
Environment=APP_ENV=production

# Loopback only (the Go server's default; stated explicitly on purpose).
# Put a TLS reverse proxy in front if you must expose it (deploy/nginx-rgt-vault.conf,
# deploy/Caddyfile.example), or let the daemon terminate TLS itself (RGT-251):
# append to ExecStart, with the key mode 0600 and owned by rgtvault (the daemon
# REFUSES a key that group/other can read), then `systemctl reload rgt-vault-go`
# re-reads the certificate without dropping connections (SIGHUP):
#   --tls-cert /etc/rgt-vault/tls/server.crt --tls-key /etc/rgt-vault/tls/server.key
#   optional mutual TLS for server-to-server clients (the bearer token is still
#   required): --tls-client-ca /etc/rgt-vault/tls/clients-ca.pem
# A non-loopback --host is refused without TLS. See docs/guides/tls.md.
# The bearer tokens are
# never logged: the journal shows only the token file paths and short ids.
# CORS is denied unless exact origins are listed, for example:
# Environment=CORS_ALLOWED_ORIGINS=https://dashboard.example
#
# Optional, append to ExecStart after creating the files (see
# `rgt-vault enroll-2fa --help`; approvals need an operator-scoped token in
# the store, which `init` creates):
#   --require-approval --totp-secret-file /var/lib/rgt-vault/totp.secret \
#   --harness-key-file /var/lib/rgt-vault/harness.key
ExecStart=/opt/rgt-vault/bin/rgt-vault serve \
    --db /var/lib/rgt-vault/vault.db \
    --policy /etc/rgt-vault/policy.yaml \
    --provider platform \
    --token-store /var/lib/rgt-vault/tokens.json \
    --host 127.0.0.1 --port 8765

# SIGHUP re-reads the TLS certificate/key without dropping connections; with
# no --tls-cert the daemon just logs and ignores it.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# --- defense in depth -------------------------------------------------- #
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Only the vault's own state dir is writable.
ReadWritePaths=/var/lib/rgt-vault
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
